# Configure these values in Netlify. Never put private credentials in VITE_*;
# Vite exposes them to every visitor in the compiled browser bundle.
VITE_API_BASE_URL=https://api.mehedinaeem.dev/api/v1
VITE_API_TIMEOUT=10000
VITE_RECAPTCHA_SITE_KEY=your_public_recaptcha_site_key
VITE_CLOUDINARY_CLOUD_NAME=your_public_cloudinary_cloud_name
VITE_APP_NAME=Your Portfolio Name
VITE_APP_AUTHOR=Your Name
